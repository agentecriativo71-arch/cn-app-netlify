# Variáveis de runtime. Não copie segredos para o bundle/build args.
# Vision ativo: Fal AI -> OpenRouter Vision -> Gemini.
# Configure o provider e o modelo de forma geral; assim a troca de modelo não exige renomear variáveis.
VISION_PROVIDER=fal
VISION_MODEL=google/gemini-2.5-flash
VISION_MAX_OUTPUT_TOKENS=1800
FAL_KEY=

# Overrides opcionais, usados somente quando o provider Fal precisar de valores diferentes.
FAL_VISION_MODEL=
FAL_VISION_REASONING=false
FAL_VISION_TEMPERATURE=0
FAL_VISION_MAX_OUTPUT_TOKENS=

# Piloto de fidelidade de tecidos no fluxo de manequim. Mantido desligado por padrão.
REALISTA_FABRIC_PIPELINE_V1=false

# Benchmark opcional. Só usado quando VISION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_VISION_DETAIL=medium
OPENAI_VISION_MAX_OUTPUT_TOKENS=
# Opcional e somente local: diretório com fixtures sintéticas/licenciadas para o smoke live.
VISION_LIVE_FIXTURE_DIR=
# PostgreSQL interno do EasyPanel: produtos, looks e sessões de upload.
DATABASE_URL=

# PostgreSQL do projeto Supabase operacional: schema privado app_analytics.
ANALYTICS_DATABASE_URL=

# Projeto Supabase operacional: Auth, Storage e dashboard.
VITE_SUPABASE_URL=https://szbptnoviikflyzulhhs.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Projeto Supabase exclusivo do CRM.
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_KEY=
CN_ORGANIZATION_ID=

# Alertas e links do dashboard operacional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_BASE_URL=http://localhost:3000

# Token somente servidor para consulta externa de execuções.
# Nunca exponha esta variável no navegador nem use prefixo VITE_.
EXECUTION_INTEGRATION_TOKEN=
